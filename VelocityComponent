class_name VelocityComponent
extends Node

@export_group("Movement Stats")
@export var max_speed: float = 300.0
@export var acceleration: float = 1800.0
@export var friction: float = 2200.0

var current_velocity: Vector2 = Vector2.ZERO

## คำนวณความเร็วแบบมีแรงเฉื่อย
func accelerate(direction: Vector2, delta: float) -> void:
	if direction.length() > 1.0:
		direction = direction.normalized()
		
	var target_velocity := direction * max_speed
	
	if direction != Vector2.ZERO:
		current_velocity = current_velocity.move_toward(target_velocity, acceleration * delta)
	else:
		current_velocity = current_velocity.move_toward(Vector2.ZERO, friction * delta)

## สำหรับบีบบังคับความเร็วทันที (เช่น Dash หรือโดนผลัก)
func set_instant_velocity(new_velocity: Vector2) -> void:
	current_velocity = new_velocity

## ส่งมอบความเร็วให้ CharacterBody2D นำไปเดิน
func apply_to(body: CharacterBody2D) -> void:
	body.velocity = current_velocity
	body.move_and_slide()
	# ซิงค์ค่ากลับเผื่อเดินชนกำแพงแล้วความเร็วกลายเป็น 0
	current_velocity = body.velocity
