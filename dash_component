class_name DashComponent
extends Node

@export var dash_speed: float = 900.0
@export var dash_duration: float = 0.15
@export var dash_cooldown: float = 0.8

var _is_dashing: bool = false
var _can_dash: bool = true
var _dash_timer: float = 0.0
var _dash_cooldown_timer: float = 0.0
var _dash_direction: Vector2 = Vector2.ZERO

## ให้อัปเดตทุกเฟรมเพื่อลดเวลา Cooldown
func update_timers(delta: float) -> void:
	if _is_dashing:
		_dash_timer -= delta
		if _dash_timer <= 0.0:
			_is_dashing = false
			
	if not _can_dash:
		_dash_cooldown_timer -= delta
		if _dash_cooldown_timer <= 0.0:
			_can_dash = true

## ร้องขอการ Dash (ส่งคืน true ถ้าทำได้)
func try_dash(direction: Vector2) -> bool:
	if not _can_dash or _is_dashing or direction == Vector2.ZERO:
		return false
		
	_dash_direction = direction.normalized()
	_is_dashing = true
	_can_dash = false
	_dash_timer = dash_duration
	_dash_cooldown_timer = dash_cooldown
	return true

## เช็คสถานะปัจจุบัน
func is_dashing() -> bool:
	return _is_dashing

## ดึงทิศทางที่กำลังพุ่งไป
func get_dash_velocity() -> Vector2:
	return _dash_direction * dash_speed
